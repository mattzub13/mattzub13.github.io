---
import "../styles/global.css";

const { title, date } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Boldonse&family=Raleway:ital,wght@0,100..900;1,100..900&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="bg-secondary text-black">
    <main
      class="prose lg:prose-xl mx-auto px-4 py-8 text-font
             prose-headings:text-black
             prose-p:text-black
             prose-li:text-black
             prose-strong:text-black
             prose-em:text-black
             prose-li
             prose-code:text-red-600
             prose-a:text-blue-600
             prose-code:px-1
             prose-code:rounded"
    >
      <h1 class="text-primary">{title}</h1>
      <p class="text-sm text-font">{date}</p>
      <slot />
    </main>
  </body>
</html>
